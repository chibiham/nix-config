# shellcheck shell=bash
# chibihamuntu: Intel Core i7-13700KF / RTX 3090 24GB（Gigabyte）1枚 / DDR4 64GB / Ubuntu 24.04
# 値は scripts/lib/ubuntu-host.sh の既定と同じ。ここに書くのは、何で動いているかを読めるようにするため。
# ただしケースファンの値（CASE_FAN_CONTROL・CASE_FAN_HWMON・CASE_FAN_CHANNELS・CASE_FAN_GPU_CURVE・CASE_FAN_CPU_CURVE・CASE_FAN_CPU_HWMON）と
# ラジエーターの組の値（CASE_FAN_RAD_CHANNELS・CASE_FAN_RAD_GPU_CURVE・CASE_FAN_RAD_CPU_*・CASE_FAN_RAD_CPU_BACKUP_*）だけは既定と違う。
# 書き方は `: "${VAR:=値}"`（呼び出し側の環境変数が優先される）。変数の意味は README.md。

: "${FLAKE_HOST:=ubuntu-server}"
: "${OP_VAULT:=chibihamuntu}"
: "${UBUNTU_USER:=chibiham}"

# Tailscale Serve（2026-11-12 の tailscale serve status と同じ）: 443 → ComfyUI、8443 → Qwen Router、8444 → Applio。
# art-studio（4520・8445）は dekahamuntu へ移したので外した（2026-11-12、本人）
: "${TAILSCALE_SERVE:=443=8188 8443=8080 8444=6969}"

: "${NVIDIA_EXPECTED_GPUS:=0}"
: "${NVIDIA_REQUIRE_OPEN:=0}"
: "${NVIDIA_MIN_DRIVER:=0}"

: "${GPU_LED_OFF:=1}"
: "${GPU_LED_MATCH:=gigabyte.*rtx ?3090}"
: "${GPU_LED_COUNT:=1}"

: "${CPU_POWER_READ:=1}"

# ケースファンを GPU の温度に合わせて回す（install-case-fan-control-ubuntu.sh、fan2go。issue 6）。docs/ubuntu-server.md の「ケースファン」。
# CPU は簡易水冷（Cooler Master MasterLiquid 360L Core。ラジエーターのファン 120mm ×3、ポンプ）。
#   ラジエーターのファン（pwm2。天面）も fan2go で操り、max(GPU の曲線, CPU の曲線) で回す（下の「ラジエーターの組」）。
#   ポンプ（pwm6 と見られる）は操らない（BIOS の制御のまま。全開）。
#   issue 6 の本文の「CPU のクーラーは操らない」「操るのはケースファンのチャネルだけ」は、本人の決めで上書きした（2026-11-15 19:25 JST ごろ。
#   執事の「天面のラジエーターのファンは CPU の温度だけで回っていて、学習中は GPU が熱くても天面の排気が上がらない。
#   GPU と CPU の高いほうで回すようにすれば排気が増える。高いほうに合わせる形なら CPU の冷却は弱くならない。やる?」に、本人が「やっとこう」）。
#   決まり: CPU の冷却を BIOS より弱くしない。
#   pwm5 は BIOS の曲線が pwm2 と同じなので、ボードの上では CPU_OPT のヘッダーかもしれないが、
#   つながっているのはケースファンなので操る（pwm5 がボードのどのヘッダーかは未確認）。
# env は 1 にした（2026-11-15）。本人が実機に入れた（2026-11-15 19:09 JST = 10:09 UTC。そのときの GPU の曲線は dekahamuntu と同じ値）。
#   下の新しい GPU の曲線は env に書いただけで、実機への入れ直し（sudo）は本人がこれから（2026-11-15 19:20 JST 時点）。
#   1 なので、configure-ubuntu-hardware.sh を流すと入れるスクリプトも流れる（流すたびに fan2go を止めて入れ直す）
: "${CASE_FAN_CONTROL:=1}"
# 実機で確かめた（2026-11-15、--probe --load-module）: 「Found NCT6798D or compatible chip at 0x2e:0x290」、hwmon の name は nct6798。
#   pwm は 1・2・4・5・6・7（pwm3 はない）で、どれも mode=1（PWM、4pin）。fan は 1〜7 の入力がある
: "${CASE_FAN_MODULE:=nct6775}"
: "${CASE_FAN_HWMON:=nct6798}"
# ケースファンのつながったチャネルは 5（本人が --identify で確かめた。2026-11-15 JST）。
#   18:25 ごろ --identify 5（全開）: fan5 が 685 → 2 秒 892 → 4 秒 1,039 → 6 秒 1,071 → 10 秒 1,031 RPM（元は enable=5 pwm=124）。ほかの fan は変わらず
#   19:00 ごろ --identify 5 --stop（pwm=0）: fan5 が 676 → 2 秒 552 → 4 秒 497 → 6 秒 478 → 8 秒 476 → 10 秒 475 RPM。止まらず回り続けた。操れる幅は約 475〜1,070 RPM
#   ケースの付属ファン 6 つ（側面・底面・背面）が付属のハブ 1 つで 5 にまとまっている、という見立て（本人・執事）。6 つ全部が 5 につながっているかは目では確かめきれていない（未確認）。
#   pwm2（ラジエーターのファン。本人が音と止めて確かめた）はケースファンの組には入れない（ラジエーターの組で操る）。pwm6（ポンプと見られる。未確認）は入れない
: "${CASE_FAN_CHANNELS:=5}"
# どの pwm も mode=1（PWM、4pin の制御）。fan5 は pwm=0 でも約 475 RPM で回り続けるので、
#   30% は「止めない」ための下限というより曲線の下の値。30% のときの回転数は未確認
#   初回の解析は止まる点がなくても通り、設定の Min 77・Start 77・Max 255 が使われた（2026-11-15 に実機で確かめた。
#   解析は 1 分 43.7 秒、境界は Start 1・Max 255 と出たが設定の値で上書き。docs/ubuntu-server.md）
: "${CASE_FAN_MIN_DUTY:=30}"
# GPU の曲線（RTX 3090 1 枚の温度）。最初は dekahamuntu と同じ値（45:30 60:45 70:65 78:85 83:100）で入れた（2026-11-15 19:09 JST）。
#   その曲線では学習中（GPU 66〜67℃）に pwm5 約 150・fan5 約 770 RPM だった。
#   同じ日（19:20 JST ごろ）に本人が前へ寄せると決めた。理由（本人の言葉の要旨）: GPU は冷やしたい。
#   天面は CPU のラジエーターのファンにしているので、排気が弱いと見ている。
#   PWM は 45℃ 77・55℃ 128・65℃ 191・72℃ 230・78℃ 255。学習中の 66〜67℃ なら約 77〜79%（PWM 197〜202）の計算（実機では未確認）
: "${CASE_FAN_GPU_CURVE:=45:30 55:50 65:75 72:90 78:100}"
# CPU の曲線は dekahamuntu と同じ値のまま
: "${CASE_FAN_CPU_CURVE:=60:30 75:45 85:65 95:100}"
# Intel なので coretemp。temp1 が Package id 0（2026-11-15 に実機で確かめた。nct6798 の temp8（PECI Agent 0）も同じ値）
: "${CASE_FAN_CPU_HWMON:=coretemp}"
: "${CASE_FAN_CPU_TEMP_CHANNEL:=1}"
# ラジエーターの組（pwm2。天面の簡易水冷のラジエーターのファン 120mm ×3）。ファン = max(GPU の曲線, CPU の曲線, CPU の保険の曲線)。
#   まだ実機には入れていない（2026-11-15 19:30 JST 時点。入れ直しは本人。docs/ubuntu-server.md の「ケースファン」）。
#   ここだけ `:=` でなく `=` で書く: 呼び出し側が空（CASE_FAN_RAD_CHANNELS=）を渡したら、組を使わない（ケースファンだけの設定を見るため）
: "${CASE_FAN_RAD_CHANNELS=2}"
# BIOS の最低（pwm2_auto_point1_pwm = 51 = 20%）と同じ。fan2 は pwm=0 で止まる（本人が --identify 2 --stop で見た）
: "${CASE_FAN_RAD_MIN_DUTY:=20}"
# GPU の曲線: まずケースファンの新しい曲線と同じ（本人・執事）。学習中（GPU 66〜67℃）は PWM 197〜202 の計算
#   （BIOS のときは pwm2 151〜158・fan2 約 1,250〜1,290 RPM）。ラジエーターのファンはケースファンよりうるさくなりうるので、
#   入れたあとの音と温度を見て本人が決める
: "${CASE_FAN_RAD_GPU_CURVE:=45:30 55:50 65:75 72:90 78:100}"
# CPU の曲線（主）: BIOS と同じ温度の源（下の temp9）で、BIOS の曲線（20:51 45:102 65:178 70:255、℃:PWM）を 3℃ 前へ寄せたもの。
#   PWM は 17℃ 51・42℃ 102・62℃ 179・67℃ 255。BIOS の曲線より、どの温度でも弱くならない（入れるスクリプトが sysfs の BIOS の曲線と比べて確かめる）。
#   3℃ 寄せる理由: fan2go は温度を約 10 秒の指数移動平均でならす（窓はセンサーごとに変えられない。全体の窓を短くすると dekahamuntu の設定も
#   変わるので変えない）。BIOS は遅れなし（pwm2_step_up_time=0）。3℃ の寄せは、毎秒 0.3℃ までの上がり方なら、ならした温度の遅れ
#   （速さ × 約 10 秒）を埋める。それより速い上がり（CPU の負荷の急な立ち上がり）では、全開に届くのが BIOS より約 10 秒遅れうる。
#   簡易水冷は冷却水とラジエーターの熱容量があり、10 秒ほどの遅れで冷却水の温度はほとんど変わらない（250W で 10 秒 = 2.5kJ。
#   熱容量を約 1〜1.5kJ/K と見て、放熱がまったくなくても 2℃ ほど。見積もり）。ポンプは BIOS のまま全開。
#   Package（coretemp）に BIOS の数字をそのまま当てない理由: Package は temp9 より高く出る（学習中 70〜76℃）ので、学習中ずっと全開になる
: "${CASE_FAN_RAD_CPU_CURVE:=17:20 42:40 62:70 67:100}"
# BIOS と同じ源: pwm2_temp_sel=9 は nct6798 の temp9（ラベル「PECI Agent 0 Calibration」）。nct6775 のドライバとドキュメントでは
#   temp_sel の値は tempN の N。実測でも合う（temp9 40.5℃ → 曲線の計算 92.8・実測 pwm2 93、50.5℃ → 122.9・実測 120。2026-11-15）
: "${CASE_FAN_RAD_CPU_HWMON:=nct6798}"
: "${CASE_FAN_RAD_CPU_TEMP_CHANNEL:=9}"
# 保険の曲線（coretemp の Package）: 主の源（temp9。ラベルに undocumented とある源）が固まる・0 を返すようになっても、Package でファンが上がる。
#   値は、観測した BIOS の動き（Package 40℃ → pwm2 83、64℃ → 120、70〜76℃ → 151〜158）以上になるようにした:
#   PWM は 40℃ 89・60℃ 128・75℃ 166・85℃ 217・92℃ 255（64℃ → 138、70℃ → 153、76℃ → 171）。
#   ふだんは保険の曲線（Package）のほうが主の曲線より少し高い値を出すので、合間のファンは BIOS より少し（PWM で 10〜20）高く回る見込み
: "${CASE_FAN_RAD_CPU_BACKUP_CURVE:=40:35 60:50 75:65 85:85 92:100}"
: "${CASE_FAN_RAD_CPU_BACKUP_HWMON:=coretemp}"
: "${CASE_FAN_RAD_CPU_BACKUP_TEMP_CHANNEL:=1}"
# TUF GAMING B760M-PLUS D4 は nct6775 の ASUS WMI のボード一覧にあり、BIOS 1220・カーネル 7.0.0-43-generic で
#   acpi_enforce_resources=lax なしで掴めた（2026-11-15）
: "${CASE_FAN_ACPI_LAX:=0}"

# 1枚をComfyUI・Qwen・Applio・学習で排他に使う（ai-mode と unit の Conflicts=）
: "${COMFY_CUDA_DEVICES:=}"
# ComfyUIの起動オプションは足さない（いまの comfyui.service と同じ。--fast fp16_accumulation は付けない）
: "${COMFY_EXTRA_ARGS:=}"
# ComfyUIの版は固定しない（update-comfyui-ubuntu.sh は master を git pull --ff-only。2026-11-14 時点で e3bee7ff）
: "${COMFY_REF:=}"
# MiniMax H3 Image は置かない（install-minimax-h3-image-ubuntu.sh を流しても何もしない）
: "${H3_IMAGE_MODELS:=}"
# art-studio は dekahamuntu へ移した（unit は disable して残してある）。drop-in は書かない
: "${ART_STUDIO_COMFYUI_URL:=}"
: "${ART_STUDIO_CUDA_DEVICES:=}"
: "${LLM_CUDA_DEVICES:=}"
: "${TRAIN_CUDA_DEVICES:=}"
: "${APPLIO_CUDA_DEVICES:=}"
: "${LLM_DUAL_CUDA_DEVICES:=}"
: "${QWEN_WANTED_BY:=comfyui.service}"
: "${QWEN_STOP_COMFY_ON_INSTALL:=1}"
# Router の --sleep-idle-seconds は付けない（いまの qwen38.service と同じ）
: "${QWEN_SLEEP_IDLE_SECONDS:=}"
: "${APPLIO_CONFLICTS:=comfyui.service qwen38.service}"
