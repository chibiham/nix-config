# shellcheck shell=bash
# chibihamuntu: Intel Core i7-13700KF / RTX 3090 24GB（Gigabyte）1枚 / DDR4 64GB / Ubuntu 24.04
# 値は scripts/lib/ubuntu-host.sh の既定と同じ。ここに書くのは、何で動いているかを読めるようにするため。
# 書き方は `: "${VAR:=値}"`（呼び出し側の環境変数が優先される）。変数の意味は README.md。

: "${FLAKE_HOST:=ubuntu-server}"
: "${OP_VAULT:=chibihamuntu}"
: "${UBUNTU_USER:=chibiham}"

# Tailscale Serve（2026-11-12 の tailscale serve status と同じ）: 443 → ComfyUI、8443 → Qwen Router、8444 → Applio。
# art-studio（4520・8445）は dekahamuntu へ移したので外した（2026-11-12、本人）
: "${TAILSCALE_SERVE:=443=8188 8443=8080 8444=6969}"

: "${NVIDIA_EXPECTED_GPUS:=0}"
: "${NVIDIA_REQUIRE_OPEN:=0}"
: "${NVIDIA_MIN_DRIVER:=0}"

: "${GPU_LED_OFF:=1}"
: "${GPU_LED_MATCH:=gigabyte.*rtx ?3090}"
: "${GPU_LED_COUNT:=1}"

: "${CPU_POWER_READ:=1}"

# 1枚をComfyUI・Qwen・Applio・学習で排他に使う（ai-mode と unit の Conflicts=）
: "${COMFY_CUDA_DEVICES:=}"
# ComfyUIの起動オプションは足さない（いまの comfyui.service と同じ。--fast fp16_accumulation は付けない）
: "${COMFY_EXTRA_ARGS:=}"
# art-studio は dekahamuntu へ移した（unit は disable して残してある）。drop-in は書かない
: "${ART_STUDIO_COMFYUI_URL:=}"
: "${ART_STUDIO_CUDA_DEVICES:=}"
: "${LLM_CUDA_DEVICES:=}"
: "${TRAIN_CUDA_DEVICES:=}"
: "${APPLIO_CUDA_DEVICES:=}"
: "${LLM_DUAL_CUDA_DEVICES:=}"
: "${QWEN_WANTED_BY:=comfyui.service}"
: "${QWEN_STOP_COMFY_ON_INSTALL:=1}"
: "${APPLIO_CONFLICTS:=comfyui.service qwen38.service}"
