# shellcheck shell=bash
# dekahamuntu: AMD Ryzen（型番は TODO）/ RTX 5060 Ti 16GB ×2（Blackwell、sm_120、NVLinkなし）/ DDR5 64GB / Ubuntu 24.04
# 書き方は `: "${VAR:=値}"`（呼び出し側の環境変数が優先される）。変数の意味は README.md。
# 実機で確かめていない値には TODO を付けている。
# このファイルは、Ubuntuを入れるときのホスト名が dekahamuntu であることを前提に読まれる（hostname -s）。

: "${FLAKE_HOST:=dekahamuntu}"
# 要確認(本人): Ubuntuのインストールで作るユーザー。chibihamuntu と同じ chibiham の想定。
#   変えるなら flake.nix の "chibiham@dekahamuntu" の username も変える（bootstrap は違えば止まる）
: "${UBUNTU_USER:=chibiham}"
# tailnetでの名前（https://dekahamuntu.<tailnet>.ts.net）。install-tailscale-ubuntu.sh が tailscale up に渡す
: "${TAILSCALE_HOSTNAME:=dekahamuntu}"
# Tailscale Serve: 443 → ComfyUI（8188）、4520 → art-studio（4520）。Qwen を入れたら 8443=8080 を足す
: "${TAILSCALE_SERVE:=443=8188 4520=4520}"
# TODO(本人): このマシン専用の Vault を1Passwordに作る（chibihamuntu と同じアイテム名）。
#   別の名前にするなら home/hosts/dekahamuntu.nix の chibiham.ubuntu.opVault も揃える
: "${OP_VAULT:=dekahamuntu}"

# Blackwellはオープンカーネルモジュールでしか動かない。R570以降が要る（CUDA 12.8 の最小は 570.117）
: "${NVIDIA_EXPECTED_GPUS:=2}"
: "${NVIDIA_REQUIRE_OPEN:=1}"
: "${NVIDIA_MIN_DRIVER:=570}"

# TODO(本人): カードのメーカー・型番が分かったら、OpenRGBで消せるかを確かめてから 1 にする。
#   確かめ方: sudo QT_QPA_PLATFORM=offscreen /opt/openrgb-1.0rc3.1/AppRun --noautoconnect --list-devices
#   一覧の行（小文字）に当たる正規表現を GPU_LED_MATCH に書き、同じカード2枚なら GPU_LED_COUNT=2
: "${GPU_LED_OFF:=0}"
: "${GPU_LED_MATCH:=rtx ?5060 ?ti}"
: "${GPU_LED_COUNT:=2}"

# AMDのRAPLも intel_rapl_msr が /sys/class/powercap/intel-rapl:0 に出す（Zen 5 は新しいカーネルが要る）。
# 出ないときはスクリプトが何も変えずに警告だけ出す。読めなければ 0 にする
: "${CPU_POWER_READ:=1}"

# ケースファンを GPU の温度に合わせて回す（install-case-fan-control-ubuntu.sh、fan2go）。docs/dekahamuntu-setup.md の「ケースファン」。
# TODO(実機): --probe で Super I/O を掴めるか・どのチャネルにケースファンがあるかを確かめてから 1 にする
: "${CASE_FAN_CONTROL:=0}"
: "${CASE_FAN_MODULE:=nct6775}"
# TODO(実機): ASUS の B850 は NCT6799D の見込み（hwmon の name は nct6799）。--probe の出力で確かめる
: "${CASE_FAN_HWMON:=nct6799}"
# TODO(実機): ケースファンのつながったチャネル（--probe の RPM と --identify で決める）。CPU_FAN は入れない
: "${CASE_FAN_CHANNELS:=}"
# TODO(実機): 3pin（DC。--probe の mode=0）のファンなら、30% では回らないことがある。50 前後に上げる
: "${CASE_FAN_MIN_DUTY:=30}"
# GPU 2 枚の温度の最大で回す。subako の見張りの警告（85℃）より前に 100% にする
: "${CASE_FAN_GPU_CURVE:=45:30 60:45 70:65 78:85 83:100}"
# Ryzen 7 9700X の Tctl（k10temp の temp1）。CPU のクーラーのファン（CPU_FAN）は BIOS のまま。
# ケースファンは CPU が熱いときも上げるが、GPU より緩くする（Tctl は負荷ですぐ上がる）
: "${CASE_FAN_CPU_CURVE:=60:30 75:45 85:65 95:100}"
: "${CASE_FAN_CPU_HWMON:=k10temp}"
: "${CASE_FAN_CPU_TEMP_CHANNEL:=1}"
# ProArt B850-CREATOR WIFI NEO は nct6775 の ASUS WMI の一覧（カーネル 7.0）にない。
# ACPI とぶつかって掴めないと --probe が言ったときだけ、本人が決めて 1 にする（GRUB を書き換え、再起動が要る）
: "${CASE_FAN_ACPI_LAX:=0}"

# 既定: GPU 0 = 画像生成（ComfyUI）、GPU 1 = LLM（qwen38.service）。
# 学習・Applio は GPU 0 を使い、ComfyUI と排他にする（GPU 1 のLLMは止めない）。
: "${COMFY_CUDA_DEVICES:=0}"
# ComfyUIの起動オプションは足さない（chibihamuntu と同じ絵にするため、--fast fp16_accumulation は付けない。本人の決定 2026-11-12）
: "${COMFY_EXTRA_ARGS:=}"
# art-studio は同じ機械の ComfyUI を直に呼び、モザイクの YOLO は GPU 0 に載せる（configure-art-studio-ubuntu.sh の drop-in）
: "${ART_STUDIO_COMFYUI_URL:=http://127.0.0.1:8188}"
: "${ART_STUDIO_CUDA_DEVICES:=0}"
: "${LLM_CUDA_DEVICES:=1}"
: "${TRAIN_CUDA_DEVICES:=0}"
: "${APPLIO_CUDA_DEVICES:=0}"

# 束ねる形: qwen38-dual.service が2枚を使う（ComfyUI・qwen38 とは排他。ai-mode llm-dual）。
# PCIe越し（NVLinkなし）なので、分割は層ごと（layer）。row はGPU間の通信が多く遅くなりやすい
: "${LLM_DUAL_CUDA_DEVICES:=0,1}"
: "${LLM_DUAL_SPLIT_MODE:=layer}"
: "${LLM_DUAL_TENSOR_SPLIT:=1,1}"

# LLMは別のGPUなので、ComfyUIとは独立に起動する
: "${QWEN_WANTED_BY:=default.target}"
: "${QWEN_STOP_COMFY_ON_INSTALL:=0}"
# dense の 27B は chibihamuntu に置く案（docs/ai-server-placement.md）。ここでは MoE だけ取得する
: "${QWEN_INSTALL_27B:=0}"
# Flash-Next のエキスパートをRAMへ置く層数（48層中）。推測値（24GBで38・35の実測から、16GBぶん引いた）。
# TODO(実機): VRAMに収まり、余りが1GB程度になるまで下げる
: "${QWEN_FLASH_N_CPU_MOE:=43}"
: "${QWEN_FLASH_UNCENSORED_N_CPU_MOE:=40}"
# 2枚を束ねるとき（合計32GB）。推測値
: "${QWEN_DUAL_FLASH_N_CPU_MOE:=33}"
: "${QWEN_DUAL_FLASH_UNCENSORED_N_CPU_MOE:=30}"

: "${APPLIO_CONFLICTS:=comfyui.service qwen38-dual.service}"
